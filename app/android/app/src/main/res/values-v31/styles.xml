<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="LaunchTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
        <!-- Android 12+ splash: fondo oscuro, sin ícono, sin círculo -->
        <item name="android:windowSplashScreenBackground">#060618</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/blink_splash</item>
        <item name="android:windowSplashScreenIconBackgroundColor">#060618</item>
    </style>
    <style name="NormalTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@android:color/black</item>
    </style>
</resources>
