# Registro de plugins auto-generado por 'flutter pub get' para plataformas
# que este proyecto no compila de verdad (linux/macos/windows) — el
# contenido difiere entre la Mac y Windows, y estar trackeado causaba que
# git pull abortara en la Mac cada vez ("your local changes would be
# overwritten by merge"). Se regenera solo, no hace falta versionarlo.
linux/flutter/generated_plugin_registrant.cc
linux/flutter/generated_plugin_registrant.h
linux/flutter/generated_plugins.cmake
macos/Flutter/GeneratedPluginRegistrant.swift
windows/flutter/generated_plugin_registrant.cc
windows/flutter/generated_plugin_registrant.h
windows/flutter/generated_plugins.cmake

# Credenciales locales (NUNCA commitear)
dart_defines/local.json

# Llave de firma de release de Android (NUNCA commitear — guardar aparte,
# ej. en un gestor de contraseñas. Si se pierde, no se pueden subir más
# actualizaciones a la misma ficha de Play Store).
android/key.properties
android/*.jks
android/*.keystore

# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release
